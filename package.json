{
  "name": "socket-board-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch workspaces/server/index.ts",
    "dev:client": "vite --host localhost",
    "build": "vite build",
    "check": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "4.12.23",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^9.1.0",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3",
    "vite": "^8.1.1"
  }
}
